# ============================================================
# Advanced Pharmacy Suite - API environment configuration
# Copy this file to ".env" and adjust values for your machine.
# ============================================================

APP_NAME="Advanced Pharmacy"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kolkata

# Comma-separated list of allowed CORS origins (Angular dev server)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------- Database ----------
# Local XAMPP: 127.0.0.1 / root / (empty)
# Hostinger production hostname is shown in hPanel → Databases (e.g. auth-dbXXXX.hstgr.io)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Three logical databases
# Local:     pharma_master / pharma_ho / pharma_ops
# Hostinger: paperlesspharmac_advancedMaster / paperlesspharmac_advho / paperlesspharmac_advancedMaindb
DB_MASTER=pharma_master
DB_HO=pharma_ho
DB_OPS=pharma_ops

# ---------- JWT / Security ----------
# Generate a long random string (>= 64 chars) for production!
JWT_SECRET=change-this-to-a-long-random-secret-key-min-64-characters-please
JWT_ISSUER=advanced-pharmacy
JWT_ACCESS_TTL=900          # access token lifetime (seconds) = 15 min
JWT_REFRESH_TTL=1209600     # refresh token lifetime (seconds) = 14 days

# Login throttling
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_DECAY_SECONDS=300

# ---------- SMTP (forgot-password OTP — same as Retail forgotPassMain.php) ----------
SMTP_HOST=paperlesspharmacy.in
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=retailwholesale@paperlesspharmacy.in
SMTP_PASS=
# Legacy alias accepted by the API:
# PAPERLESS_SMTP_PASS=
SMTP_FROM_NAME="PaperLess Pharmacy"
SMTP_BCC_SENDER=true

# ---------- File storage ----------
UPLOAD_MAX_MB=50

# ---------- Import Bill: Gmail OAuth ----------
# Create OAuth credentials in Google Cloud Console (Gmail API readonly).
# Redirect URI must match exactly (default uses APP_URL):
#   {APP_URL}/api/import/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------- Import Bill: AI extraction ----------
# openai (default if OPENAI_API_KEY set) | gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional Gemini fallback
# GEMINI_API_KEY=
# AI_API_KEY=
# AI_MODEL=gemini-2.0-flash

# ---------- WhatsApp (Unique Digital Outreach — same as Retail medicin_bill) ----------
WHATSAPP_API_URL=https://api.uniquedigitaloutreach.com/v1/whatsapp
WHATSAPP_API_KEY=
WHATSAPP_FROM=+15558342917
WHATSAPP_CAMPAIGN=medicin-bill
WHATSAPP_TEMPLATE=medicin_bill
# AuraGharTak stock catalogue link (template auraghartak)
WHATSAPP_AGT_TEMPLATE=auraghartak
WHATSAPP_AGT_CAMPAIGN=auraghartak
WHATSAPP_AGT_DELIVERED_TEMPLATE=tablet_reminder
WHATSAPP_AGT_DELIVERED_CAMPAIGN=aura_ghar_tak_delivered
# Patient shop URL base (Angular), e.g. http://192.168.1.108:5555 or https://demo.paperlesspharmacy.in
PUBLIC_FRONTEND_URL=http://localhost:4200
# Daily closing (Retail template daily_closing) — uses WHATSAPP_API_KEY / WHATSAPP_FROM above
WHATSAPP_DC_CAMPAIGN=daily-closing
WHATSAPP_DC_TEMPLATE=daily_closing
# Public folder URL WhatsApp can fetch (must be HTTPS-reachable)
WHATSAPP_PDF_PUBLIC_BASE=
# Optional absolute dir for PDF files (default: sibling ../invoices of php/)
# WHATSAPP_PDF_DIR=

# ---------- Razorpay (Android subscription Checkout) ----------
# Dashboard → API Keys. Key secret + webhook secret stay server-only.
# Webhook URL: {APP_URL}/api/subscription/webhook
# Events: payment.captured, order.paid
RAZORPAY_KEY_ID=rzp_test_TrfCKeRBV4dl34
RAZORPAY_KEY_SECRET=4BtQUaCS1osARB23SU6ID4hG
RAZORPAY_WEBHOOK_SECRET=MyTestWebhookSecret@2026

# ---------- Retail Paperless Pharmacy (AuraGharTak app proxy) ----------

# The Android app calls /api/public/retail/*; the key stays on the server only.
RETAIL_API_BASE=https://paperlesspharmacy.in/serverdev
RETAIL_API_KEY=

# ---------- Paperless Share Stock → Inward Stock ----------
# Public receive: /server/partner_sale_receive.php (and /api/partner/sale-receive)
PARTNER_SHARE_API_KEY=plp_share_stock_c414_k9m2x7q1
PARTNER_SHARE_CLIENT_ID=5
PARTNER_SHARE_BRANCH_ID=
PARTNER_SHARE_CLIENT_NO=C414
PARTNER_SHARE_ALLOWED_SOURCES=paperlesspharmacy.in
PARTNER_SHARE_ALLOWED_SOURCE_CLIENTS=C414

# ---------- Partner API (EyeFlow EMR stock visibility) ----------
# Option A — single pharmacy client (simplest for one EyeFlow clinic):
# PARTNER_API_KEY=generate-a-long-random-secret
# PARTNER_CLIENT_ID=1
# PARTNER_NAME=EyeFlow
# PARTNER_BRANCH_IDS=          # optional comma-separated branch IDs; empty = all branches
#
# Option B — multiple keys / clients (JSON). Do not put secrets in frontend.
# PARTNER_API_KEYS={"long-secret-key":{"client_id":1,"partner":"EyeFlow","branch_ids":[]}}
PARTNER_API_KEY=
PARTNER_CLIENT_ID=
PARTNER_NAME=EyeFlow
PARTNER_BRANCH_IDS=
# PARTNER_API_KEYS=