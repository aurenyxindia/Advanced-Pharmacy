# ============================================================
# Advanced Pharmacy Suite - PRODUCTION (paperlesspharmacy.in)
# On the server: copy this file to ".env"
# Local XAMPP should keep using config/.env (127.0.0.1)
# ============================================================

APP_NAME="Advanced Pharmacy Suite"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://paperlesspharmacy.in
APP_TIMEZONE=Asia/Kolkata

# Add your live frontend origin(s)
CORS_ALLOWED_ORIGINS=https://paperlesspharmacy.in,https://www.paperlesspharmacy.in

# ---------- Database (cPanel / MariaDB) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Mapped from local:
# pharma_master -> paperlesspharmac_advancedMaster
# pharma_ho     -> paperlesspharmac_advho
# pharma_ops    -> paperlesspharmac_advancedMaindb
DB_MASTER=paperlesspharmac_advancedMaster
DB_HO=paperlesspharmac_advho
DB_OPS=paperlesspharmac_advancedMaindb

# ---------- JWT / Security ----------
# IMPORTANT: generate a new secret on the server before go-live
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_64_PLUS_CHARS_FOR_PRODUCTION
JWT_ISSUER=advanced-pharmacy
JWT_ACCESS_TTL=28800
JWT_REFRESH_TTL=1209600

RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_DECAY_SECONDS=300

UPLOAD_MAX_MB=50
